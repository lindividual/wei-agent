#!/bin/sh
set -e

moon check

# `core/` holds the portable half of the reimplementation: message model,
# provider codecs, agent loop, session store. It has to compile for every
# backend, which is only true while it stays free of platform code.
#
# If one of these fails, something under core/ reached for IO. Fix the code,
# not this script.
moon check -p core --target js
moon check -p core --target wasm-gc

# The bundled `script` programs are MoonBit source inside string literals, so no
# type checker sees them: a typo compiles the project and fails only when a model
# calls that script. This compiles and runs all of them.
#
# It is a separate executable rather than a test because running it means running
# `moon`, and `moon run` from inside `moon test` deadlocks on the build lock —
# measured, twice. Keep it out of `moon test`.
moon run scriptcheck
